#!/usr/bin/env bash
# Thin wrapper so the CLI can be symlinked onto PATH (e.g. ~/bin) without a build step.
# Node >= 23.6 runs the TypeScript sources directly via type stripping.
set -euo pipefail
src="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
exec node --disable-warning=ExperimentalWarning "$src/src/cli.ts" "$@"
